<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.LauncherKiosk" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.LauncherKiosk" parent="Base.Theme.LauncherKiosk" />

    <style name="Theme.LauncherKiosk.Wallpaper" parent="Theme.LauncherKiosk">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
